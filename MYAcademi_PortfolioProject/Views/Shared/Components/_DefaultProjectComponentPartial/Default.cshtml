
@model List<MYAcademi_PortfolioProject.Entities.Project>

@{
    var categories = Model
        .SelectMany(x => x.ProjectCategories)
        .Select(x => x.Category)
        .DistinctBy(x => x.CategoryId)
        .OrderBy(x => x.CategoryId)
        .ToList();
}

<!-- 8. Featured Projects Section -->
<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Filter Buttons -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button class="filter-btn active" data-filter="all">Tümü</button>
                <button class="filter-btn" data-filter="web">Web Uygulamaları</button>
                <button class="filter-btn" data-filter="ai">Yapay Zeka</button>
                <button class="filter-btn" data-filter="mobile">Mobil</button>
                <button class="filter-btn" data-filter="microservices">Mikroservisler</button>
            </div>
        </div>

        <!-- Project Grid -->
        <div class="row g-4" id="projectGrid">

            @foreach (var project in Model)
            {
                <div class="col-lg-6 project-item reveal-on-scroll"
                     data-category="@(string.Join(" ", project.ProjectCategories.Select(x => x.Category.CategorySlug)))">

                    <div class="project-card">

                        <div class="project-thumb-wrap">
                            <img src="@project.ImageUrl"
                                 alt="@project.ProjectTitle"
                                 class="project-thumb-img">

                            <span class="project-category-tag">
                                @string.Join(" & ", project.ProjectCategories.Select(x => x.Category.CategoryName))
                            </span>
                        </div>

                        <div class="project-body">

                            <h3 class="h4 fw-bold mb-2">
                                @project.DisplayOrder. @project.ProjectTitle
                            </h3>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @project.Description
                            </p>

                            <!-- Technologies -->
                            <div class="mb-4">
                                @foreach (var item in project.ProjectSkillItems)
                                {
                                    <span class="tech-badge">
                                        @item.SkillItem.SkillItemTitle
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">

                                <a href="@(project.ProjectUrl ?? "#contact")"
                                   class="btn-sage btn-sm">
                                    <span>Projeyi İncele</span>
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>

                                <span class="text-muted small">
                                    @if (!string.IsNullOrEmpty(project.StatusIcon))
                                    {
                                        <i class="@project.StatusIcon me-1"></i>
                                    }
                                    @project.StatusText
                                </span>

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="text-center mt-5">
            <a href="#contact" class="btn-secondary-custom px-4 py-3">
                <span>Tüm Projelerimi Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
