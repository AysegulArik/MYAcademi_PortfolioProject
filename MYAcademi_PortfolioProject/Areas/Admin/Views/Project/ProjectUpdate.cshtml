
@model MYAcademi_PortfolioProject.Entities.Project

@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">

    <br />

    <h4 class="page-title">Proje Güncelle</h4>

    <div class="card">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Project"
                  asp-action="ProjectUpdate"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProjectId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label>Proje Adı</label>
                    <input type="text" asp-for="ProjectTitle"
                           class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3" required></textarea>
                </div>

                <div class="form-group mb-3">
                    <label>Görsel Yolu</label>
                    <input type="text" asp-for="ImageUrl"
                           class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Proje URL</label>
                    <input type="text" asp-for="ProjectUrl"
                           class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>GitHub URL</label>
                    <input type="text" asp-for="GithubUrl"
                           class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Durum Metni</label>
                    <input type="text" asp-for="StatusText"
                           class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Durum İkonu</label>
                    <input type="text" asp-for="StatusIcon"
                           class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Gösterim Sırası</label>
                    <input type="number" asp-for="DisplayOrder"
                           class="form-control" min="1" required />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" asp-for="IsFeatured"
                           class="form-check-input" />
                    <label class="form-check-label" asp-for="IsFeatured">
                        Öne Çıkan Proje
                    </label>
                </div>

                <div class="form-group mb-3">
                    <label>Kategoriler</label>

                    <select name="selectedCategoryIds"
                            asp-items="ViewBag.Categories"
                            class="form-select"
                            multiple
                            size="6">
                    </select>

                    <small class="text-muted">
                        Birden fazla kategori seçmek için Ctrl tuşunu kullanabilirsiniz.
                    </small>
                </div>

                <div class="form-group mb-3">
                    <label>Teknolojiler</label>

                    <select name="selectedSkillItemIds"
                            asp-items="ViewBag.SkillItems"
                            class="form-select"
                            multiple
                            size="8">
                    </select>

                    <small class="text-muted">
                        Birden fazla teknoloji seçmek için Ctrl tuşunu kullanabilirsiniz.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Güncelle
                </button>

                <a href="/Admin/Project/ProjectList"
                   class="btn btn-secondary">
                    Vazgeç
                </a>

            </form>

        </div>
    </div>
</div>
