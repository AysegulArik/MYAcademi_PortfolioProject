@model List<MYAcademi_PortfolioProject.Entities.Experience>
@{
    ViewData["Title"] = "Experience List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

 <!-- CONTENT BODY -->

            
<main class="page-content-area">

    <!-- Page Header Row -->
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Deneyimlerim Listesi</h1>
            <p class="page-subtitle">
                Portfolyo sitenizde yer alacak deneyim içeriklerini buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="header-actions">
            <button type="button"
                    class="btn-pastel-primary"
                    onclick="document.getElementById('inlineExperienceForm').scrollIntoView({ behavior: 'smooth' });">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Deneyim Ekle</span>
            </button>
        </div>
    </div>

    <!-- Main Experience Table Container -->
    <div class="data-table-card">

        <!-- Experience Table -->
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table" id="experienceTable">

                <thead>
                    <tr>
                        <th style="width: 44px; text-align: center;">
                            <input type="checkbox" class="custom-checkbox" id="selectAllCheckbox" title="Tümünü Seç">
                        </th>
                        <th style="width: 60px;">ID</th>
                        <th>Deneyim Başlığı</th>
                        <th>Kurum / Şirket</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 140px;">İşlemler</th>
                    </tr>
                </thead>



               <tbody id="experienceTableBody">

    @foreach (var item in Model)
    {
        <tr data-id="@item.ExperienceId"
            data-status="@(item.IsActive ? "Aktif" : "Pasif")">

            <td style="text-align: center;">
                <input type="checkbox" class="custom-checkbox row-select-checkbox">
            </td>

            <td class="col-id">#@item.ExperienceId</td>

            <td>
                <div class="experience-title-cell">
                    <div class="exp-icon-bullet">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>
                        <span class="exp-title-text">@item.Title</span>
                        <small class="text-muted d-block" style="font-size:0.75rem;">
                            @item.Description
                        </small>
                    </div>
                </div>
            </td>

            <td>
                <div class="company-cell">
                    <i class="bi bi-building company-badge-icon"></i>
                    <span>@item.CompanyName</span>
                </div>
            </td>

            <td>
                <span class="work-type-badge">@item.CategoryName</span>
            </td>

            <td>
                <span class="status-pill @(item.IsActive ? "status-active" : "status-passive")">
                    @(item.IsActive ? "Aktif" : "Pasif")
                </span>
            </td>

            <td style="text-align: right;">
                <div class="row-actions-group justify-content-end">
                    <button type="button"
        class="btn-action-icon btn-view"
        title="Görüntüle"
        data-bs-toggle="modal"
        data-bs-target="#experienceDetailModal"
        data-title="@item.Title"
        data-company="@item.CompanyName"
        data-category="@item.CategoryName"
        data-description="@item.Description"
        data-status="@(item.IsActive ? "Aktif" : "Pasif")">
    <i class="bi bi-eye"></i>
</button>

                   <a asp-area="Admin"
   asp-controller="Experience"
   asp-action="UpdateExperience"
   asp-route-id="@item.ExperienceId"
   class="btn-action-icon btn-edit"
   title="Güncelle">
    <i class="bi bi-pencil-square"></i>
</a>

                    <form asp-area="Admin"
              asp-controller="Experience"
              asp-action="DeleteExperience"
              method="post"
              style="display:inline;"  onsubmit="return confirmDeleteExperience(event)">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@item.ExperienceId" />

            <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                <i class="bi bi-trash3"></i>
            </button>

        </form>
                </div>
            </td>

        </tr>
    }

</tbody>
          </table>
        </div>

       
<!-- Table Footer: Pagination & Counter -->
@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    int startRecord = ViewBag.StartRecord;
    int endRecord = ViewBag.EndRecord;
}

<div class="table-footer-area">

    <div class="pagination-counter">
        Toplam <strong>@totalCount</strong> kayıttan
        <strong>@startRecord-@endRecord</strong> arası gösteriliyor
    </div>

    <ul class="custom-pagination">

        <!-- Önceki Sayfa -->
        <li class="page-nav-item">
            <a asp-action="ExperienceList"
               asp-route-page="@(currentPage - 1)"
               class="page-nav-btn @(currentPage == 1 ? "disabled" : "")"
               title="Önceki Sayfa">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>

        <!-- Sayfa Numaraları -->
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-nav-item">
                <a asp-action="ExperienceList"
                   asp-route-page="@i"
                   class="page-nav-btn @(currentPage == i ? "active" : "")">
                    @i
                </a>
            </li>
        }

        <!-- Sonraki Sayfa -->
        <li class="page-nav-item">
            <a asp-action="ExperienceList"
               asp-route-page="@(currentPage + 1)"
               class="page-nav-btn @(currentPage == totalPages || totalPages == 0 ? "disabled" : "")"
               title="Sonraki Sayfa">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>

    </ul>
</div>


      <!-- Quick Add / Edit Side Panel & ASP.NET Core Integration Note -->
      <div class="side-drawer-card">
        <div class="drawer-header">
          <div>
            <h3 class="drawer-title">
              <i class="bi bi-plus-square"></i>
              Hızlı Deneyim Oluşturma Paneli
            </h3>
            <br /><br />
      
        <form asp-area="Admin"
      asp-controller="Experience"
      asp-action="CreateExperience"
      method="post"
      id="inlineExperienceForm">

    @Html.AntiForgeryToken()
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label-custom">Deneyim Başlığı <span class="required-star">*</span></label>
              <input type="text"
      name="Title"
       class="form-control-custom"
       placeholder="Örn: QA Automation Tester"
       required />
            </div>
            <div class="col-md-6">
              <label class="form-label-custom">Şirket / Kurum Adı <span class="required-star">*</span></label>
              <input type="text"
       name="CompanyName"
       class="form-control-custom"
       placeholder="Örn: Freelance Projects"
       required />
            </div>
            <div class="col-md-4">
              <label class="form-label-custom">Çalışma Türü</label>
              <select name="CategoryName" class="form-control-custom">
    <option value="Software Testing">Software Testing</option>
    <option value="Test Automation">Test Automation</option>
    <option value="Web Development">Web Development</option>
    <option value="Education">Education</option>
</select>
            </div>
            <div class="col-md-4">
              <label class="form-label-custom">Başlangıç Tarihi</label>
              <input type="text" class="form-control-custom" placeholder="Örn: Ocak 2023">
            </div>
            <div class="col-md-4">
              <label class="form-label-custom">Bitiş Tarihi</label>
              <input type="text" class="form-control-custom" id="endDateInput" placeholder="Örn: Devam Ediyor">
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input custom-checkbox" type="checkbox" id="ongoingCheck" onchange="toggleOngoingDate(this)">
                <label class="form-check-label ms-1" for="ongoingCheck" style="font-size:0.85rem; color:var(--text-secondary);">
                  Hala bu pozisyonda çalışmaya devam ediyorum
                </label>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label-custom">Açıklama / Görev Kapsamı</label>
             <textarea name="Description"
          class="form-control-custom"
          rows="2"
          placeholder="Üstlenilen sorumluluklar, kullanılan teknolojiler ve başarılar..."></textarea>
            </div>
            <div class="col-md-4">
              <label class="form-label-custom">Durum</label>
              <select  name="IsActive" class="form-control-custom">
    <option value="true">Aktif (Portfolyoda Göster)</option>
    <option value="false">Pasif (Gizli)</option>
</select>
            </div>
            <div class="col-md-4">
              <label class="form-label-custom">Sıralama Önceliği</label>
              <input type="number" class="form-control-custom" value="5" min="1">
            </div>
            <div class="col-md-4 d-flex align-items-end justify-content-end gap-2">
              <button type="reset" class="btn-pastel-secondary" style="padding: 8px 14px;">İptal</button>
              <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                <i class="bi bi-check-lg"></i>
                <span>Kaydet</span>
              </button>
            </div>
          </div>
        </form>

        
<div class="aspnet-tip-box">
    <i class="bi bi-info-circle-fill"
       style="color:var(--accent-primary-hover); font-size:1.1rem;"></i>

    <div>
        <strong>Bilgilendirme:</strong>
        Deneyim bilgilerinizi bu panel üzerinden ekleyebilir,
        güncelleyebilir ve yönetebilirsiniz.
        Aktif olarak işaretlenen deneyimler portfolyo sitenizde görüntülenir.
    </div>
</div>

      </div>
      <!-- Deneyim Detay Modal -->
<div class="modal fade" id="experienceDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Deneyim Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <strong>Deneyim Başlığı:</strong>
                    <p id="detailTitle"></p>
                </div>

                <div class="mb-3">
                    <strong>Şirket / Kurum:</strong>
                    <p id="detailCompany"></p>
                </div>

                <div class="mb-3">
                    <strong>Kategori:</strong>
                    <p id="detailCategory"></p>
                </div>

                <div class="mb-3">
                    <strong>Açıklama:</strong>
                    <p id="detailDescription"></p>
                </div>

                <div class="mb-3">
                    <strong>Durum:</strong>
                    <p id="detailStatus"></p>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Kapat
                </button>
            </div>

        </div>
    </div>
</div>

    </main>
   <script>
    function confirmDeleteExperience(event) {
        event.preventDefault();

        const form = event.target;

        Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu deneyim kaydı silinecek!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });

        return false;
    }
</script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            title: 'Başarılı!',
            text: '@TempData["SuccessMessage"]',
            icon: 'success',
            confirmButtonText: 'Tamam'
        });
    </script>
}