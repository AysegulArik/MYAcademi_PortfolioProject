
@model MYAcademi_PortfolioProject.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">

    <h4 class="page-title">Yetenek Düzenle</h4>

    <div class="card">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Skill"
                  asp-action="UpdateSkill"
                  method="post">

                <input type="hidden" asp-for="SkillId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label>Yetenek Başlığı</label>
                    <input type="text" asp-for="Title" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label>İkon Sınıfı</label>
                    <input type="text" asp-for="IconUrl" class="form-control" />
                    <small class="text-muted">
                        Örnek: bi bi-code-slash
                    </small>
                </div>

                <div class="form-group mb-3">
                    <label>Teknolojiler</label>

                    <select name="selectedSkillItemIds"
                            asp-items="ViewBag.SkillItems"
                            class="form-select"
                            multiple
                            size="8">
                    </select>

                    <small class="text-muted">
                        En fazla 5 teknoloji seçebilirsiniz.
                        Birden fazla seçim için Ctrl tuşunu kullanabilirsiniz.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Güncelle
                </button>

                <a href="/Admin/Skill/SkillList" class="btn btn-secondary">
                    Vazgeç
                </a>

            </form>

        </div>
    </div>
</div>
