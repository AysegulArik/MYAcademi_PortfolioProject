
@model MYAcademi_PortfolioProject.Entities.Skill

@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">

    <h4 class="page-title">Yeni Yetenek Ekle</h4>

    <div class="card">
        <div class="card-body">

            <form asp-area="Admin" asp-controller="Skill" asp-action="CreateSkill" method="post">
             
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label>Yetenek Başlığı</label>
                    <input type="text" asp-for="Title" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label>İkon Sınıfı</label>
                    <input type="text" asp-for="IconUrl" class="form-control" />
                    <small class="text-muted">
                        Örnek: bi bi-code-slash
                    </small>
                </div>

                <div class="form-group mb-3">
                    <label>Teknolojiler</label>

                    <select name="selectedSkillItemIds"
                            id="selectedSkillItemIds"
                            asp-items="ViewBag.SkillItems"
                            class="form-select"
                            multiple
                            size="8">
                    </select>

                    <small class="text-muted">
    En fazla 5 teknoloji seçebilirsiniz.
    Birden fazla seçim için Ctrl tuşunu kullanabilirsiniz.
                  </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Kaydet
                </button>

                <a href="/Admin/Skill/SkillList" class="btn btn-secondary">
                    Vazgeç
                </a>

            </form>

        </div>
    </div>
</div>
