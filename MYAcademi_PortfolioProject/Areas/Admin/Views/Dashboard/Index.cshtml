@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";


    // Dinamik veriler (controller'dan)
    int total = ViewBag.v1;
    int unread = ViewBag.v2;
    int read = ViewBag.v3;
    int rate = total == 0 ? 0 : read * 100 / total;

    // Statik (UI) veriler
    var labels = (List<string>)ViewBag.Labels;
var counts = (List<int>)ViewBag.Counts;
var last = (List<MYAcademi_PortfolioProject.Entities.Message>)ViewBag.LastMessages;

int max = counts.Max();
}

<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .db-title small {
            color: var(--muted);
            font-weight: 400;
        }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green {
        background: var(--g-soft);
        color: var(--g);
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: .8rem;
        height: 190px;
    }

    .bar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        gap: .4rem;
    }

    .bar-fill {
        width: 100%;
        max-width: 42px;
        background: var(--g);
        border-radius: 8px 8px 4px 4px;
        opacity: .85;
        transition: opacity .2s;
    }

    .bar:hover .bar-fill {
        opacity: 1;
    }

    .bar span {
        font-size: .75rem;
        color: var(--muted);
    }

    .bar b {
        font-size: .8rem;
    }

    .donut {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: .5rem auto 1.2rem;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--g) calc(var(--p) * 1%), var(--g-soft) 0);
    }

        .donut div {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 1.6rem;
            font-weight: 700;
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            margin-right: .35rem;
        }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .8rem 0;
        border-bottom: 1px solid var(--line);
    }

        .msg-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .6rem;
        border-radius: 20px;
    }
    .portfolio-stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.portfolio-stat-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px 20px;
    border-radius: 16px;
    background: white;
    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
    transition: all 0.3s ease;
    border-left: 5px solid transparent;
}

.portfolio-stat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
}

.portfolio-stat-icon {
    width: 58px;
    height: 58px;
    min-width: 58px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
}

.portfolio-stat-info span {
    font-size: 13px;
    color: #777;
    font-weight: 600;
}

.portfolio-stat-info h2 {
    font-size: 30px;
    font-weight: 800;
    margin: 5px 0;
}

.portfolio-stat-info small {
    font-size: 11px;
    color: #999;
}

/* Mavi */
.experience-card {
    border-color: #3B82F6;
}
.experience-card .portfolio-stat-icon {
    background: #DBEAFE;
    color: #2563EB;
}
.experience-card h2 {
    color: #2563EB;
}

/* Yeşil */
.project-card {
    border-color: #10B981;
}
.project-card .portfolio-stat-icon {
    background: #D1FAE5;
    color: #059669;
}
.project-card h2 {
    color: #059669;
}

/* Turuncu */
.skill-card {
    border-color: #F59E0B;
}
.skill-card .portfolio-stat-icon {
    background: #FEF3C7;
    color: #D97706;
}
.skill-card h2 {
    color: #D97706;
}

/* Mor */
.active-card {
    border-color: #A855F7;
}
.active-card .portfolio-stat-icon {
    background: #F3E8FF;
    color: #9333EA;
}
.active-card h2 {
    color: #9333EA;
}

@@media (max-width: 992px) {
    .portfolio-stat-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 576px) {
    .portfolio-stat-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="db container-fluid py-3">
     <!-- Portfolyo istatistik kartları -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="portfolio-stat-card experience-card">
                <div class="portfolio-stat-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div class="portfolio-stat-info">
                    <span>Toplam Deneyim</span>
                    <h2>@ViewBag.TotalExperience</h2>
                    <small>Deneyim kayıtlarınız</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="portfolio-stat-card project-card">
                <div class="portfolio-stat-icon">
                    <i class="bi bi-folder-fill"></i>
                </div>
                <div class="portfolio-stat-info">
                    <span>Toplam Proje</span>
                    <h2>@ViewBag.TotalProject</h2>
                    <small>Portfolyo projeleriniz</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="portfolio-stat-card skill-card">
                <div class="portfolio-stat-icon">
                    <i class="bi bi-lightbulb-fill"></i>
                </div>
                <div class="portfolio-stat-info">
                    <span>Toplam Yetenek</span>
                    <h2>@ViewBag.TotalSkill</h2>
                    <small>Kayıtlı yetenekleriniz</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="portfolio-stat-card active-card">
                <div class="portfolio-stat-icon">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
                <div class="portfolio-stat-info">
                    <span>Öne Çıkarılan Proje</span>
                    <h2>@ViewBag.ActiveProject</h2>
                    <small>Öne çıkarılmış projeleriniz</small>
                </div>
            </div>
        </div>

    </div>


    <!-- Dinamik istatistik kartları -->
    <div class="row g-4 mb-4">
        @{
            var stats = new[] {
                (Val: total,  Lbl: "Toplam Mesaj", Icon: "bi-envelope",             Cls: "c-green"),
                (Val: unread, Lbl: "Okunmamış",    Icon: "bi-envelope-exclamation", Cls: "c-rose"),
                (Val: read,   Lbl: "Okunmuş",      Icon: "bi-envelope-check",       Cls: "c-blue")
            };
        }
        @foreach (var s in stats)
        {
            <div class="col-md-4">
                <div class="db-card stat">
                    <div class="stat-icon @s.Cls"><i class="bi @s.Icon"></i></div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <!-- Haftalık grafik (statik) -->
        <div class="col-xl-8">
            <div class="db-card">
                <div class="db-title">Son 7 Gün <small>Günlük gelen mesajlar</small></div>
                <div class="bars">
                    @for (int i = 0; i < 7; i++)
{
    <div class="bar">
        <b>@counts[i]</b>
        <div class="bar-fill"
             style="height:@(max == 0 ? 0 : counts[i] * 100 / max)%">
        </div>
        <span>@labels[i]</span>
    </div>
}
                </div>
            </div>
        </div>

        <!-- Okunma oranı (v1 ve v3'ten hesaplanır) -->
        <div class="col-xl-4">
            <div class="db-card">
                <div class="db-title">Okunma Oranı</div>
                <div class="donut" style="--p:@rate"><div>%@rate</div></div>
                <div class="legend">
                    <span><i style="background:var(--g)"></i>Okundu (@read)</span>
                    <span><i style="background:var(--g-soft)"></i>Okunmadı (@unread)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Son mesajlar (statik) -->
    <div class="db-card">
        <div class="db-title">
            Son Mesajlar
            <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
        </div>

        
@foreach (var m in last)
{
    <div class="msg-row">

        <div class="avatar">
            @(string.IsNullOrWhiteSpace(m.SenderName)
                ? "?"
                : m.SenderName.Substring(0, 1).ToUpper())
        </div>

        <div class="msg-body">
            <strong>@m.SenderName</strong>
            · <span class="small">@m.Subject</span>

            <p>@m.MessageDetail</p>
        </div>

        <small class="text-muted d-none d-md-block">
            @m.SendDate.ToString("dd.MM.yyyy HH:mm")
        </small>

        @if (m.IsRead)
        {
            <span class="badge-soft c-blue">Okundu</span>
        }
        else
        {
            <span class="badge-soft c-rose">Yeni</span>
        }

    </div>
}

    </div>
</div>


